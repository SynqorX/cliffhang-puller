# 1. Ignore everything by default
/*

# 2. Whitelist project metadata and git files
!.gitignore
!README*

# 3. Whitelist build files (required for Android Studio to recognize the project)
!build.gradle*
!settings.gradle*
!gradle.properties
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat

# 4. Whitelist the app module directory structure
!app/
!app/build.gradle*
!app/proguard-rules.pro
app/*
!app/src/
app/src/*
!app/src/main/
app/src/main/*

# 5. Whitelist the 4 specific files/folders you care about
# (1) AndroidManifest.xml
!app/src/main/AndroidManifest.xml

# (2 & 3) Kotlin source files
!app/src/main/java/
!app/src/main/java/**

# (4) Layout resources
!app/src/main/res/
!app/src/main/res/layout/
!app/src/main/res/layout/**

# 6. Safety catch: ignore build artifacts, caches, and IDE configs
build/
**/build/
.gradle/
.idea/
*.iml
.DS_Store
